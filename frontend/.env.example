# 기본 모드는 mock이며 아래 값을 생략해도 서버 없는 데모가 실행됩니다.
VITE_APP_MODE=mock

# 실제 백엔드 연결 시에만 자리표시자를 교체하세요.
VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_NEXT_URL=/api/oauth/callback/kakao/token/d-t-d?code
VITE_KAKAO_REST_API_KEY=replace-with-kakao-rest-api-key
VITE_KAKAO_REDIRECT_URI=http://localhost:3000/oauth/callback/kakao/token

# 선택 사항: 값이 없으면 분석 이벤트를 전송하지 않습니다.
VITE_GA_KEY=
